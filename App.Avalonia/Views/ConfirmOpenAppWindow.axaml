<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Coder.Desktop.App.Views.ConfirmOpenAppWindow"
        Title="Coder Desktop"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="16" Spacing="12">
        <TextBlock Text="{Binding Prompt}" TextWrapping="Wrap" />
        <CheckBox x:Name="DontAskAgainCheckBox" Content="{Binding DontAskAgainLabel}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" Click="CancelClicked" />
            <Button Content="Open" Classes="accent" IsDefault="True" Click="OpenClicked" />
        </StackPanel>
    </StackPanel>
</Window>
